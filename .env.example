# OPTIONAL — both deploy paths work with no .env at all.
# setup-db.sh writes DATABASE_URL / PG_NETWORK / APP_PORT here for path B.
# Set anything below only if you want to override the defaults.

# ADMIN_EMAIL=you@company.com
# ADMIN_PASSWORD=            # blank = generated on first boot and printed once
# JWT_SECRET=                # blank = generated and stored in the database
# APP_PORT=8080              # host port for the dashboard
# DB_PASSWORD=               # path A only: password for the bundled database
# SAMPLE_INTERVAL_S=10
# ALERT_TICK_S=30

# ---- AI chat (local vLLM, OpenAI-compatible) -------------------------------
# Unset = the chat page loads but reports that it cannot reach vLLM.
# Must be reachable from inside the app container.
# VLLM_BASE_URL=http://host.docker.internal:8000/v1

# Blank = first model from /v1/models. If set, must match that id exactly.
# VLLM_MODEL=

# Past messages forwarded to the model, on top of the fleet system prompt.
# CHAT_MAX_HISTORY=20

# ---- AI chat behaviour -----------------------------------------------------
# Qwen3 reasoning is chosen per question (off for lookups, on for analysis).
# Set to 0 if the served chat template does not understand enable_thinking.
# AI_THINKING=1
# Tool-gathering rounds before the model must answer. 0 disables tool use.
# AI_MAX_TOOL_ROUNDS=2
# Let admins' questions reach a guarded read-only SELECT. Off by default —
# read the database-role section of docs/AI-CHAT.md before turning it on.
# AI_ALLOW_SQL=0
# AI_SQL_TIMEOUT_MS=5000
# A local model writing a full report can legitimately take minutes.
# AI_REQUEST_TIMEOUT_MS=180000
